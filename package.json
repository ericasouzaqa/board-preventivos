{
  "name": "board-preventivos",
  "version": "2.0.0",
  "description": "Board de Cards Preventivos — registro e métricas de qualidade preventiva.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.qualidade.board-preventivos",
    "productName": "Board de Cards Preventivos",
    "files": ["index.html", "main.js", "preload.js", "renderer.js", "styles.css"],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
